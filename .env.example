# Copy to .env and fill in.
# Discord bot credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id

# Optional: restrict slash command deployment to a single guild during dev
# (faster command propagation than global). Leave blank for global deploy.
DEV_GUILD_ID=

# Where the SQLite DB file lives, relative to project root.
DB_PATH=./data/musicevents.db

# Where uploaded submission files are stored, relative to project root.
UPLOAD_DIR=./data/uploads

# ---------- Web dashboard ----------
# Port for the local admin dashboard. Visit http://localhost:<port>/
DASHBOARD_PORT=3000

# Random string used to sign session cookies. Set to anything long & secret.
DASHBOARD_SESSION_SECRET=change-me-to-something-random

# Discord OAuth2 credentials. Found on the same Developer Portal page as your
# bot token, under "OAuth2 → Client information".
# Add http://localhost:3000/auth/callback as a redirect URL on that page.
DISCORD_OAUTH_CLIENT_SECRET=

# ---------- Dev mode ----------
# When true, the dashboard skips Discord OAuth and logs you in as a dev admin.
# You can also create fake "test" signups to try out matching/MMR by yourself.
DASHBOARD_DEV_MODE=false

# Your real Discord user ID. In dev mode this is used so the bot can DM you
# real notifications even though you bypassed OAuth. Right-click yourself in
# Discord (with Developer Mode on) → Copy User ID.
DEV_USER_ID=
